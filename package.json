{
	"name": "@hello-eme/play-source",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nx run-many -t build",
		"lint": "nx run-many -t lint",
		"check": "nx run-many -t check",
		"test": "nx run-many -t test",
		"format": "prettier --write .",
		"docs": "nx run play-schema:build && node scripts/gen-reference.mjs && prettier --write docs/REFERENCE.md docs/REFERENCE.de.md",
		"format:check": "prettier --check .",
		"verify": "npm run format:check && nx run-many -t lint check test build",
		"changeset": "changeset",
		"release": "npm run build && changeset publish",
		"prepare": "husky",
		"e2e": "nx run-many -t e2e"
	},
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^9.39.5",
		"@types/node": "^24.0.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"nx": "23.3.0",
		"prettier": "^3.8.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^4.0.18"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts}": [
			"prettier --write",
			"eslint --fix --no-warn-ignored"
		],
		"*.{css,json,md,yml,yaml,html}": "prettier --write"
	},
	"overrides": {
		"undici": "^7.29.1"
	}
}
