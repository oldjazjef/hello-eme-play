{
	"name": "@hello-eme/play-schema",
	"version": "0.0.0",
	"description": "The JSON configuration of @hello-eme/play: types, validation, defaults and migrations. No DOM.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"game",
		"engine"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run --passWithNoTests"
	}
}
