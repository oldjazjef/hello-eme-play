{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"production": ["default"],
		"sharedGlobals": []
	},
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"check": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"lint": {
			"cache": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"e2e": {
			"dependsOn": ["^build"]
		}
	},
	"analytics": false,
	"useDaemonProcess": false
}
